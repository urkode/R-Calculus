{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "r-calculus",
  "main": "worker.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "r-kalkyle-production",
      "database_id": "dcb86c92-f2d7-463d-b7e7-340f7afb6f87"
    }
  ]
}
